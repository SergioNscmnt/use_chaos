<div class="d-flex justify-content-between align-items-center mb-4">
  <div><h1>Usuários internos</h1><p class="texto-suave mb-0">Perfis e acesso à administração.</p></div>
  <%= link_to "Novo usuário", new_administracao_usuario_administrativo_path, class: "btn btn-neon" %>
</div>
<div class="card card-neon"><div class="tabela-responsiva"><table class="table card-table">
  <thead><tr><th>Nome</th><th>E-mail</th><th>Perfil</th><th>Situação</th><th></th></tr></thead>
  <tbody>
    <% @usuarios.each do |usuario| %>
      <tr><td><%= usuario.nome %></td><td><%= usuario.email %></td><td><%= usuario.perfil.nome.humanize %></td><td><%= usuario.ativo? ? "Ativo" : "Inativo" %></td><td class="text-end"><%= link_to "Editar", edit_administracao_usuario_administrativo_path(usuario), class: "btn btn-sm btn-outline-light" %></td></tr>
    <% end %>
  </tbody>
</table></div></div>
