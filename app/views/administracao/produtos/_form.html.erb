<%= render "shared/erros_formulario", objeto: produto %>
<%= form_with model: [:administracao, produto], class: "card card-neon", multipart: true do |form| %>
  <div class="card-body">
    <div class="row g-3">
      <div class="col-md-8"><%= form.label :nome, class: "form-label" %><%= form.text_field :nome, class: "form-control", required: true %></div>
      <div class="col-md-4"><%= form.label :sku, "SKU", class: "form-label" %><%= form.text_field :sku, class: "form-control", required: true %></div>
      <div class="col-md-6"><%= form.label :categoria_id, "Categoria", class: "form-label" %><%= form.collection_select :categoria_id, Categoria.ordenadas, :id, :nome, {}, class: "form-select", required: true %></div>
      <div class="col-md-6"><%= form.label :slug, class: "form-label" %><%= form.text_field :slug, class: "form-control", placeholder: "gerado automaticamente" %></div>
      <div class="col-12"><%= form.label :descricao, "Descrição", class: "form-label" %><%= form.text_area :descricao, rows: 5, class: "form-control", required: true %></div>
      <div class="col-md-4"><%= form.label :preco_centavos, "Preço (centavos)", class: "form-label" %><%= form.number_field :preco_centavos, min: 0, class: "form-control", required: true %></div>
      <div class="col-md-4"><%= form.label :custo_centavos, "Custo (centavos)", class: "form-label" %><%= form.number_field :custo_centavos, min: 0, class: "form-control", required: true %></div>
      <div class="col-md-4"><%= form.label :limiar_estoque_baixo, "Limiar de estoque baixo", class: "form-label" %><%= form.number_field :limiar_estoque_baixo, min: 0, class: "form-control" %></div>
      <div class="col-12 d-flex flex-wrap gap-4">
        <% { ativo: "Ativo", publicado: "Publicado", disponivel: "Disponível", destaque: "Destaque" }.each do |campo, rotulo| %>
          <label class="form-check"><%= form.check_box campo, class: "form-check-input" %><span class="form-check-label"><%= rotulo %></span></label>
        <% end %>
      </div>
      <div class="col-12"><%= form.label :lancamento_em, "Data de lançamento", class: "form-label" %><%= form.datetime_local_field :lancamento_em, class: "form-control" %></div>
      <div class="col-12">
        <h2 class="h4">Galeria</h2>
        <%= form.fields_for :imagens_produto do |imagem_form| %>
          <div class="row g-2 border rounded p-3 mb-2">
            <div class="col-md-5"><%= imagem_form.label :arquivo, "Imagem", class: "form-label" %><%= imagem_form.file_field :arquivo, accept: ImagemProduto::TIPOS_PERMITIDOS.join(","), class: "form-control" %></div>
            <div class="col-md-5"><%= imagem_form.label :texto_alternativo, "Texto alternativo", class: "form-label" %><%= imagem_form.text_field :texto_alternativo, class: "form-control" %></div>
            <div class="col-md-2"><%= imagem_form.label :posicao, "Ordem", class: "form-label" %><%= imagem_form.number_field :posicao, min: 0, class: "form-control" %></div>
            <div class="col-12 d-flex gap-4">
              <label class="form-check"><%= imagem_form.check_box :principal, class: "form-check-input" %><span class="form-check-label">Principal</span></label>
              <% if imagem_form.object.persisted? %><label class="form-check"><%= imagem_form.check_box :_destroy, class: "form-check-input" %><span class="form-check-label">Remover</span></label><% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <div class="card-footer d-flex gap-2"><%= form.submit "Salvar", class: "btn btn-neon" %><%= link_to "Cancelar", administracao_produtos_path, class: "btn btn-link" %></div>
<% end %>
