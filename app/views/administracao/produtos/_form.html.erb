<%= render "shared/erros_formulario", objeto: produto %>
<%= form_with model: [:administracao, produto], class: "card card-neon", multipart: true do |form| %>
  <div class="card-body">
    <div class="row g-3">
      <div class="col-md-8"><%= form.label :nome, class: "form-label" %><%= form.text_field :nome, class: "form-control", required: true %></div>
      <div class="col-md-4"><%= form.label :sku, "SKU", class: "form-label" %><%= form.text_field :sku, class: "form-control", required: true %></div>
      <div class="col-md-6"><%= form.label :categoria_id, "Categoria", class: "form-label" %><%= form.collection_select :categoria_id, Categoria.ordenadas, :id, :nome, {}, class: "form-select", required: true %></div>
      <div class="col-md-6"><%= form.label :slug, class: "form-label" %><%= form.text_field :slug, class: "form-control", placeholder: "gerado automaticamente" %></div>
      <div class="col-12"><%= form.label :descricao, "Descrição", class: "form-label" %><%= form.text_area :descricao, rows: 5, class: "form-control", required: true %></div>
      <div class="col-md-4"><%= form.label :preco, "Preço", class: "form-label" %><%= form.text_field :preco, inputmode: "decimal", autocomplete: "off", placeholder: "R$ 0,00", class: "form-control", required: true, data: { controller: "mascara-monetaria", action: "input->mascara-monetaria#formatar" } %></div>
      <div class="col-md-4"><%= form.label :custo, "Custo", class: "form-label" %><%= form.text_field :custo, inputmode: "decimal", autocomplete: "off", placeholder: "R$ 0,00", class: "form-control", required: true, data: { controller: "mascara-monetaria", action: "input->mascara-monetaria#formatar" } %></div>
      <div class="col-md-4"><%= form.label :limiar_estoque_baixo, "Limiar de estoque baixo", class: "form-label" %><%= form.number_field :limiar_estoque_baixo, min: 0, class: "form-control" %></div>
      <div class="col-12 d-flex flex-wrap gap-4">
        <% { ativo: "Ativo", publicado: "Publicado", disponivel: "Disponível", destaque: "Destaque" }.each do |campo, rotulo| %>
          <label class="form-check"><%= form.check_box campo, class: "form-check-input" %><span class="form-check-label"><%= rotulo %></span></label>
        <% end %>
      </div>
      <div class="col-12"><%= form.label :lancamento_em, "Data de lançamento", class: "form-label" %><%= form.datetime_local_field :lancamento_em, class: "form-control" %></div>
      <div class="col-12" data-controller="galeria-produto">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
          <div>
            <h2 class="h4 mb-1">Galeria</h2>
            <p class="texto-suave mb-0">Adicione uma ou mais imagens e escolha a principal do catálogo.</p>
          </div>
          <button type="button"
                  class="btn btn-outline-light"
                  data-action="galeria-produto#adicionar">
            <%= conteudo_botao("Adicionar imagem", :adicionar) %>
          </button>
        </div>
        <div class="d-grid gap-3" data-galeria-produto-target="lista">
          <%= form.fields_for :imagens_produto do |imagem_form| %>
            <%= render "administracao/produtos/campo_imagem", imagem_form: %>
          <% end %>
        </div>
        <template data-galeria-produto-target="modelo">
          <%= form.fields_for :imagens_produto, ImagemProduto.new, child_index: "NOVA_IMAGEM" do |imagem_form| %>
            <%= render "administracao/produtos/campo_imagem", imagem_form: %>
          <% end %>
        </template>
      </div>
    </div>
  </div>
  <div class="card-footer d-flex gap-2"><%= form.button conteudo_botao("Salvar", :salvar), type: :submit, class: "btn btn-neon" %><%= link_to conteudo_botao("Cancelar", :cancelar), administracao_produtos_path, class: "btn btn-link" %></div>
<% end %>
