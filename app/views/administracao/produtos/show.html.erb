<div class="d-flex flex-wrap justify-content-between gap-3 mb-4">
  <div><h1><%= @produto.nome %></h1><p class="texto-suave"><%= @produto.sku %> · <%= @produto.categoria.nome %></p></div>
  <div><%= link_to conteudo_botao("Editar", :editar), edit_administracao_produto_path(@produto), class: "btn btn-neon" %></div>
</div>

<section class="mt-4" aria-labelledby="titulo-galeria-produto">
  <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
    <h2 id="titulo-galeria-produto" class="h3 mb-0">Pré-visualização da galeria</h2>
    <span class="texto-suave"><%= pluralize(imagens_exibiveis(@produto).size, "imagem", plural: "imagens") %></span>
  </div>
  <div class="col-xl-8">
    <%= render "publico/produtos/carrossel", produto: @produto %>
  </div>
</section>

<div class="row row-cards">
  <div class="col-lg-8">
    <div class="card card-neon"><div class="card-body">
      <p><%= simple_format @produto.descricao %></p>
      <dl class="row mb-0">
        <dt class="col-sm-4">Preço</dt><dd class="col-sm-8"><%= moeda_centavos(@produto.preco_centavos) %></dd>
        <dt class="col-sm-4">Custo</dt><dd class="col-sm-8"><%= moeda_centavos(@produto.custo_centavos) %></dd>
        <dt class="col-sm-4">Estoque</dt><dd class="col-sm-8"><%= @produto.estoque %></dd>
      </dl>
    </div></div>
  </div>
  <div class="col-lg-4">
    <div class="card card-neon"><div class="card-body">
      <h2 class="h4">Ajustar estoque</h2>
      <%= form_with url: ajustar_estoque_administracao_produto_path(@produto), method: :patch do |form| %>
        <%= form.label :quantidade, "Nova quantidade", class: "form-label" %>
        <%= form.number_field :quantidade, min: 0, value: @produto.estoque, class: "form-control mb-3", required: true %>
        <%= form.label :motivo, class: "form-label" %>
        <%= form.text_field :motivo, class: "form-control mb-3", required: true %>
        <%= form.button conteudo_botao("Atualizar estoque", :atualizar), type: :submit, class: "btn btn-destaque w-100" %>
      <% end %>
    </div></div>
  </div>
</div>
