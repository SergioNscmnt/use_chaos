<article class="card card-neon h-100">
  <% imagem = produto.imagens_produto.find(&:principal?) || produto.imagens_produto.first %>
  <% if imagem&.arquivo&.attached? %>
    <%= image_tag imagem.arquivo, alt: imagem.texto_alternativo, class: "card-img-top", loading: "lazy", width: 640, height: 420 %>
  <% else %>
    <div class="ratio ratio-4x3 d-grid place-items-center bg-dark-subtle"><span class="m-auto texto-suave">Imagem em breve</span></div>
  <% end %>
  <div class="card-body d-flex flex-column">
    <span class="text-uppercase small texto-suave"><%= produto.categoria.nome %></span>
    <h3 class="h2 mt-2"><%= link_to produto.nome, produto_path(produto.slug), class: "stretched-link text-decoration-none text-white" %></h3>
    <p class="texto-suave flex-grow-1"><%= truncate(produto.descricao, length: 110) %></p>
    <div class="d-flex justify-content-between align-items-center">
      <strong class="fs-2 text-orange"><%= moeda_centavos(produto.preco_centavos) %></strong>
      <span class="badge <%= produto.compravel? ? "bg-green-lt" : "bg-secondary-lt" %>"><%= produto.compravel? ? "Disponível" : "Indisponível" %></span>
    </div>
  </div>
</article>
