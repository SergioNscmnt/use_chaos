<% content_for :title, "Pedido #{@pedido.numero} criado" %>
<div class="row justify-content-center text-center">
  <div class="col-lg-8">
    <section class="card card-neon"><div class="card-body p-4 p-md-5">
      <span class="badge bg-green-lt mb-3">Pedido criado</span>
      <h1><%= @pedido.numero %></h1>
      <p class="lead texto-suave">Seu pedido foi registrado. Agora abra o WhatsApp para confirmar disponibilidade e concluir o atendimento.</p>
      <a href="<%= @url_whatsapp %>" class="btn btn-destaque btn-lg mt-3" target="_blank" rel="noopener">Abrir WhatsApp</a>
      <p class="small texto-suave mt-4 mb-0">Se o aplicativo não abrir, use o botão novamente em um dispositivo com WhatsApp instalado ou WhatsApp Web.</p>
    </div></section>
  </div>
</div>
