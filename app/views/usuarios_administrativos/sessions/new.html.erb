<% content_for :title, "Entrar na administração" %>

<div class="row justify-content-center py-5">
  <div class="col-sm-10 col-md-7 col-lg-5">
    <section class="card card-neon" aria-labelledby="titulo-login">
      <div class="card-body p-4">
        <h1 id="titulo-login" class="h2 mb-1">Área administrativa</h1>
        <p class="texto-suave mb-4">Entre com sua conta interna.</p>

        <%= form_with model: resource, scope: resource_name, url: session_path(resource_name) do |form| %>
          <div class="mb-3">
            <%= form.label :email, "E-mail", class: "form-label" %>
            <%= form.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", required: true %>
          </div>
          <div class="mb-3">
            <%= form.label :password, "Senha", for: "senha-administrativa", class: "form-label" %>
            <div class="input-group" data-controller="visibilidade-senha">
              <%= form.password_field :password,
                    id: "senha-administrativa",
                    autocomplete: "current-password",
                    class: "form-control",
                    required: true,
                    data: { visibilidade_senha_target: "campo" } %>
              <button type="button"
                      class="btn btn-outline-light"
                      aria-label="Exibir senha"
                      aria-controls="senha-administrativa"
                      aria-pressed="false"
                      data-action="visibilidade-senha#alternar"
                      data-visibilidade-senha-target="botao">
                <%= icone_acao :visualizar, data: { visibilidade_senha_target: "iconeExibir" } %>
                <%= icone_acao :ocultar, classes: "d-none", data: { visibilidade_senha_target: "iconeOcultar" } %>
                <span data-visibilidade-senha-target="rotulo">Exibir</span>
              </button>
            </div>
          </div>
          <% if devise_mapping.rememberable? %>
            <label class="form-check mb-4">
              <%= form.check_box :remember_me, class: "form-check-input" %>
              <span class="form-check-label">Manter sessão neste dispositivo</span>
            </label>
          <% end %>
          <%= form.button conteudo_botao("Entrar", :entrar), type: :submit, class: "btn btn-neon w-100" %>
        <% end %>
      </div>
    </section>
  </div>
</div>
